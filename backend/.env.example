ENVIRONMENT=development
DATABASE_URL=sqlite:///./copilot.db
# Generate independent random keys with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
VIEWER_API_KEY=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
ELASTIC_URL=
ELASTIC_API_KEY=
REDIS_URL=
# Trusted, administrator-configured destinations only. No destinations accepted from API clients.
ZAPIER_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
CRM_WEBHOOK_URL=
AUTOMATIC_REMINDERS=false
REMINDER_COOLDOWN_HOURS=24
ALLOWED_COUNTRIES=ZA,GB,US
HIGH_VALUE_THRESHOLD=10000
# Use a same-origin backend proxy in production. Only add explicit origins if direct browser access is needed.
CORS_ORIGINS=
FIREBASE_PROJECT_ID=brokerr-5ba5c
FIREBASE_MERCHANT_ID=paypal-broker
# Keep this JSON file outside the repo. On Contabo it is mounted read-only.
FIREBASE_CREDENTIALS_FILE=
