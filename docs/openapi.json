        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "suspend",
              "activate",
              "cancel"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "SubscriptionAction"
      },
