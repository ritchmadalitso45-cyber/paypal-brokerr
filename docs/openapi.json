        ],
        "title": "ChatRequest"
      },
      "CreateInvoice": {
        "properties": {
          "customer_email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Customer Email"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "title": "Due Date"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_email",
          "currency",
          "due_date",
          "items"
        ],
        "title": "CreateInvoice"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineItem": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 127,
            "minLength": 1,
            "title": "Name"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "unit_amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "quantity",
          "unit_amount"
        ],
        "title": "LineItem"
      },
      "Reconciliation": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "confirmed_succeeded",
              "confirmed_not_applied"
            ],
            "title": "Outcome"
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 20,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "evidence"
        ],
        "title": "Reconciliation"
      },
      "Reminder": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Subject",
            "default": "A friendly payment reminder"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "note"
        ],
        "title": "Reminder"
      },
