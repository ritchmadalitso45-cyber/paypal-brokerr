            "type": "string",
            "enum": [
              "zapier",
              "slack",
              "crm"
            ],
            "title": "Destination"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event",
          "destination"
        ],
        "title": "WorkflowRequest"
      }
